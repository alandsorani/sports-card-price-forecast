.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
.DS_Store

# Generated data. Templates are tracked; actual observations are yours.
data/interim/
data/processed/
data/external/*
!data/external/README.md
data/raw/*.csv
!data/raw/*.template.csv
